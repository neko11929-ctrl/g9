# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://noctiva.example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose. Used for download counting and admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Private bucket: original videos (never public)
R2_PRIVATE_BUCKET=noctiva-private
# Public bucket: thumbnails + short preview clips (public domain / r2.dev enabled)
R2_PUBLIC_BUCKET=noctiva-public
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---- Instagram import (optional) ----
# Long-lived token from Instagram API with Instagram Login for YOUR OWN professional account.
INSTAGRAM_ACCESS_TOKEN=

# ---- Misc ----
# Any long random string; used to hash visitor IPs for download de-duplication.
IP_HASH_SALT=replace-with-a-long-random-secret
